# SurveyAgent Backend Environment Configuration Template
PORT=8080
APP_ENV=development

# JWT Secret Key for RBAC token signing
JWT_SECRET=your-super-secret-jwt-key-here

# Database Connection (PostgreSQL DSN)
POSTGRES_DSN=host=localhost user=postgres password=postgres dbname=surveyagent_db port=5432 sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/surveyagent_db?sslmode=disable

# File Upload Storage Directory
STORAGE_PATH=./uploads
